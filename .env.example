# ===========================================
# BuyerAnons - Конфігурація
# ===========================================
# Скопіюйте цей файл в .env та заповніть значення

# -------------------------------------------
# DeepL API (для перекладу на українську)
# -------------------------------------------
# Отримати безкоштовний ключ: https://www.deepl.com/pro-api
# Безкоштовний план: 500,000 символів/місяць
DEEPL_API_KEY=

# -------------------------------------------
# Telegram Bot
# -------------------------------------------
# Створити бота: https://t.me/BotFather
# 1. Відправте /newbot
# 2. Введіть ім'я бота
# 3. Скопіюйте токен
TELEGRAM_BOT_TOKEN=

# Ваш Chat ID (отримати: відправте /id боту)
TELEGRAM_ADMIN_CHAT_ID=

# Список дозволених користувачів (Chat ID через кому)
# Якщо порожньо - бот доступний всім
TELEGRAM_ALLOWED_USERS=

# -------------------------------------------
# Viber Bot (застаріло - використовуйте Telegram)
# -------------------------------------------
VIBER_BOT_TOKEN=
VIBER_BOT_NAME=BuyerAnons
VIBER_WEBHOOK_URL=

# -------------------------------------------
# bit.ly (опціонально - для скорочення посилань)
# -------------------------------------------
# Отримати: https://bitly.com/a/oauth_apps
BITLY_API_KEY=

# -------------------------------------------
# Налаштування за замовчуванням
# -------------------------------------------
# Кількість товарів за замовчуванням
DEFAULT_TOP_COUNT=10

# Мінімальна знижка % за замовчуванням
DEFAULT_MIN_DISCOUNT=30

# -------------------------------------------
# Логування
# -------------------------------------------
# Рівні: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -------------------------------------------
# Сервер (для webhook)
# -------------------------------------------
HOST=0.0.0.0
PORT=8080
