# DeepL API для перевода
# Получить: https://www.deepl.com/pro-api
DEEPL_API_KEY=your_deepl_api_key_here

# bit.ly для сокращения ссылок
# Получить: https://bitly.com/a/oauth_apps
BITLY_API_KEY=your_bitly_api_key_here

# Viber Bot
# Получить: https://partners.viber.com/
VIBER_BOT_TOKEN=your_viber_bot_token_here
VIBER_BOT_NAME=BuyerAnons
VIBER_WEBHOOK_URL=https://your-domain.com/viber/webhook

# Настройки по умолчанию
DEFAULT_TOP_COUNT=10
DEFAULT_MIN_DISCOUNT=30

# Логирование
LOG_LEVEL=INFO
